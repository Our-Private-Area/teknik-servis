rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // İşletme Halka Açık Bilgileri (Herkes okuyabilir, yetkili güncelleyebilir)
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if request.auth != null || true; // İlk kurulum veya yetkili erişim
    }

    // Servis Kayıtları (Müşteri takip no ile sorgulayabilir, randevu açabilir)
    match /services/{serviceId} {
      allow read: if true;
      allow create: if true; // Online randevu oluşturma için açık
      allow update, delete: if true;
    }

    // Müşteriler, Stok, Personel ve Kasa (İşletme içi modüller)
    match /customers/{customerId} {
      allow read, write: if true;
    }
    match /stock/{stockId} {
      allow read, write: if true;
    }
    match /staff/{staffId} {
      allow read, write: if true;
    }
    match /cashTransactions/{txId} {
      allow read, write: if true;
    }

    // Platform Sahibi Finansal İşlemleri
    match /platformTransactions/{ptxId} {
      allow read, write: if true;
    }
  }
}
