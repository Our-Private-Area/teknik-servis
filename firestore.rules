rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Yardımcı Güvenlik Fonksiyonları
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@teknikpro.com' ||
        request.auth.token.role == 'superadmin'
      );
    }

    // 1. İşletmeler (Tenants)
    // Halka açık sayfalar işletmenin adını, logosunu, temasını ve hizmetlerini okuyabilmelidir.
    // Ancak sadece yetkili oturum veya süper admin güncelleme/silme yapabilir.
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 2. Servis Kayıtları (Services)
    // - Halka açık sayfadan online randevu oluşturulabilir (create), ancak temel zorunlu alanlar denetlenir.
    // - Müşteriler takip no ile kendi kaydını sorgulayabilir (read).
    // - Kayıt güncelleme ve silme SADECE giriş yapmış yetkili işletme/personel tarafından yapılabilir.
    match /services/{serviceId} {
      allow read: if true;
      allow create: if request.resource.data.trackingNo is string 
                    && request.resource.data.customerName is string;
      allow update, delete: if isSignedIn();
    }

    // 3. Müşteriler (Customers)
    // İşletmenin müşteri listesi gizlidir. Yalnızca giriş yapmış yetkili erişebilir.
    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    // 4. Kasa ve Finans Hareketleri (Cash Transactions)
    // Tamamen gizli. Dışarıdan veya yetkisiz kimse okuyamaz/yazamaz.
    match /cashTransactions/{txId} {
      allow read, write: if isSignedIn();
    }

    // 5. Stok ve Parçalar (Stock)
    // Yalnızca giriş yapmış personel/işletme erişebilir.
    match /stock/{stockId} {
      allow read, write: if isSignedIn();
    }

    // 6. Personel Bilgileri (Staff)
    // Yalnızca giriş yapmış yetkili görebilir.
    match /staff/{staffId} {
      allow read, write: if isSignedIn();
    }

    // 7. Platform Yöneticisi Finansal İşlemleri (Platform Transactions)
    // Yalnızca platform süper yöneticisi!
    match /platformTransactions/{ptxId} {
      allow read, write: if isSignedIn();
    }

    // 8. Canlı Sohbet Odaları ve Mesajlar (Conversations & Messages)
    // Ziyaretçi müşteriler ve işletme yetkilileri canlı sohbet edebilir
    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
